# RapidAPI (CURP / utilidades)
RAPIDAPI_KEY=pon_aqui_tu_key

# SocialKit (TikTok / Instagram)
SOCIALKIT_KEY=pon_aqui_tu_key

# Numeros owners extra separados por coma (opcional).
# Nota: venian de los antiguos src/config/owners.js (ya eliminados, nunca se
# importaban). Confirmalos o borralos.
OWNER_ID=525644444644,525612222222

# Puerto del healthcheck HTTP (opcional, default 3000)
PORT=3000

# Fija la version de Baileys si te sale "code: 515" en bucle.
# Sin esto el bot consulta la ultima de `master` en GitHub, que a veces ya no
# acepta WhatsApp. Formato sin "v" y separado por puntos.
# Ejemplo: BAILEYS_VERSION=2.3000.1028694800
BAILEYS_VERSION=

# Ruta de la sesion de WhatsApp (opcional, por defecto ./sessions)
SESSION_DIR=

# Si WhatsApp revoca la sesion (401), se borra para pedir QR nuevo.
# Ponlo en false si no quieres perder la sesion aunque la revoquen.
AUTO_RESET_SESSION=true

# Nivel de log de Baileys: silent | error | warn | info | debug (opcional)
LOG_LEVEL=error

# Auto-actualizar yt-dlp al conectar (opcional, default false en Docker)
AUTO_UPDATE_YTDLP=false